root = true
[*.cs]
# Allows WinForms designer names (btnLogin, button1) without warnings
dotnet_diagnostic.IDE1006.severity = none
# Allows traditional using blocks if needed
dotnet_diagnostic.IDE0063.severity = none
# Allows standard object instantiation
dotnet_diagnostic.IDE0090.severity = none
# Suppresses Windows-only platform warnings
dotnet_diagnostic.CA1416.severity = none